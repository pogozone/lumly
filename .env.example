NODE_ENV=production
PORT=3000

DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_NAME=lumly
DATABASE_USER=lumly
DATABASE_PASSWORD=

APP_ORIGIN=https://analytics.example.org

# Random >= 32 chars, used to sign nothing but as entropy anchor for tokens/CSRF pepper
COOKIE_SECRET=

# One-time token to create the first admin via POST /api/v1/auth/setup
ADMIN_SETUP_TOKEN=

DEFAULT_RETENTION_DAYS=90
GEO_ENABLED=false
# Optional path to a local MMDB (GeoLite2-Country) file when GEO_ENABLED=true
GEO_DB_PATH=

# Seed demo data on boot (only when SEED_DEMO=true and database has no sites)
SEED_DEMO=false

# Log level: fatal|error|warn|info|debug
LOG_LEVEL=info
