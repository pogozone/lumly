{
  "name": "@lumly/browser",
  "version": "1.0.0",
  "description": "lumly privacy-first browser tracker. BASIC mode uses no cookies, no storage and no fingerprinting.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "happy-dom": "^15.11.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
